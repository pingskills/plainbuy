# Maintainer: Jeff Plumb <dark.tire0486@plumbmail.com>
pkgname=plainbuy
pkgver=0.1.6
pkgrel=1
pkgdesc='A small native Bitcoin buy app for CoinSpot Markets'
arch=('x86_64' 'aarch64')
url='https://github.com/pingskills/plainbuy'
license=('MIT')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libstdc++' 'libsodium' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'ninja' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3ad95cc70f714b557892ae392634c487dd1b4736abb036e08a9aa15719b32b31')

build() {
  cmake -B "build-$pkgver" -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DPLAINBUY_BUILD_TESTS=ON
  cmake --build "build-$pkgver"
}

check() {
  ctest --test-dir "build-$pkgver" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "build-$pkgver"
}
